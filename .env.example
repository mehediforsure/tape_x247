# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to true only when authenticated routes are enabled.
SUPABASE_AUTH_ENABLED=false

# Server-only secret for the subscription endpoint. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
